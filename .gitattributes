# Vendored reference data is pinned BY HASH. Git must not touch a byte of it:
# end-of-line conversion on checkout would change the hash the tests pin, and the
# pin is what makes "validated against the official schema" a checkable statement.
# `-text` disables all end-of-line conversion for these paths.
tests/schemas/** -text
tests/vectors/** -text

# Source stays normalised so the repository reads the same on every platform.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
