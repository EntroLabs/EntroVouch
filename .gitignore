__pycache__/
*.pyc
.pytest_cache/
.coverage
*.egg-info/
.venv/

# Internal documents: must never reach the public repo.
# ENTROVOUCH is single-branch by design: there is no internal branch to hide
# them on, so they are excluded here instead. This makes the separation
# structural rather than a thing someone has to remember at commit time.
Project_Log.md
STATUS.md
NEXT.md

# SIGNING KEY MATERIAL: never, under any circumstance, in this repository.
# The keyfile holds the master seed for the Merkle signing identity. Anyone
# holding it can forge every report this publisher will ever issue, and the
# identity cannot be un-published once a reader has pinned its root.
# These patterns are the control: without them nothing prevents a keyfile being
# committed to a PUBLIC repo.
*.key
*.key.json
*key.json
*keyfile*
entrovouch_identity*
signing_identity*

# profiler output
*.prof
*.pstats
/*.out
